---
/**
 * Achievements: a JRPG list of little things to find around the site,
 * like the Breakdowns list (same windows, same ▶ cursor, ↑/↓ to move).
 *
 * Progress lives in the visitor's browser (localStorage, see
 * src/scripts/achievements.ts), so the page renders every row as locked
 * and the script fills in what's been found before the list deals in.
 * Hidden ones read "???" until found; locked ones show a hint.
 *
 * Collect them all for the platinum, "Keeper of the Light": the lighthouse
 * beam turns gold.
 */
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import PixelIcon from "@/components/achievements/PixelIcon.astro";
import ClassPortrait from "@/components/achievements/ClassPortrait.astro";
import { ACHIEVEMENTS, PLATINUM, PLAYER_TYPES, WHERE, type PlayerType } from "@/scripts/achievements";
import config from "@/config";

const total = ACHIEVEMENTS.length;
const types = Object.entries(PLAYER_TYPES) as [PlayerType, { name: string; blurb: string }][];
---

<Layout title={`Achievements | ${config.site.title}`}>
  <Header />

  <Main pageTitle="Achievements" pageDesc="Little things to find around the site. They're saved in your browser.">
    <div class="ach-page" data-ach-page>
      <!-- Progress: a count and a bar of blocks, one per achievement. -->
      <div class="progress" aria-live="polite">
        <p class="progress-count"><span data-found>0</span> / {total} found</p>
        <div class="progress-bar" aria-hidden="true">
          {ACHIEVEMENTS.map(() => <span />)}
        </div>
      </div>

      <!-- Your class (like the save files'), from what you've found: a
           bar for each class, and the one you lean towards. -->
      <div class="types" data-types>
        <div class="types-text">
          <p class="types-main"><span class="types-kicker">Your class</span> <span data-main-type>Not sure yet</span></p>
          <p class="types-blurb" data-main-blurb>Find a few things and we'll see what you came here for.</p>
          <ul class="types-bars">
            {
              types.map(([t, info]) => (
                <li data-type={t}>
                  <span class="types-name">{info.name}</span>
                  <span class="types-bar" aria-hidden="true"><span /></span>
                  <span class="types-count" data-type-count />
                </li>
              ))
            }
          </ul>
        </div>
        <!-- Your class, as a little pixel party member. With the platinum,
             the wardrobe: wear any class's look (← → or the arrows). -->
        <div class="types-portrait">
          <ClassPortrait />
          <div class="wardrobe" data-wardrobe hidden>
            <button type="button" class="wr-btn" data-look="-1" aria-label="Previous look">◀</button>
            <span class="wr-name" data-look-name aria-live="polite"></span>
            <button type="button" class="wr-btn" data-look="1" aria-label="Next look">▶</button>
          </div>
        </div>
      </div>

      <!-- The platinum: locked until everything is found. -->
      <div class="platinum" data-platinum>
        <span class="icon"><PixelIcon name="trophy" /></span>
        <div class="text">
          <p class="kicker">Platinum</p>
          <h2 class="title">
            <span class="when-on">{PLATINUM.title}</span>
            <span class="when-off">???</span>
          </h2>
          <p class="desc">
            <span class="when-on">{PLATINUM.desc} Thanks for playing. <a href="/credits" class="credits-link">Open the Credits ▶</a></span>
            <span class="when-off">Find everything below.</span>
          </p>
        </div>
      </div>

      <ul class="list" data-ach-list>
        {
          ACHIEVEMENTS.map(a => (
            <li class:list={["ach", { "is-hidden": a.hidden }]} data-ach={a.id} tabindex="0">
              <span class="cursor" aria-hidden="true">▶</span>
              <span class="icon">
                <PixelIcon name={a.icon} class="ic-on" />
                <PixelIcon name="lock" class="ic-off" />
              </span>
              <div class="text">
                <h2 class="title">
                  <span class="when-on">{a.title}</span>
                  <span class="when-off">{a.hidden ? "???" : a.title}</span>
                  <span class={`ach-type t-${a.type}`}>{PLAYER_TYPES[a.type].name}</span>
                </h2>
                <p class="desc">
                  <span class="when-on">{a.desc}</span>
                  <span class="when-off">Hint: {a.hint}</span>
                </p>
              </div>
              <span class="date" data-date></span>
              {WHERE[a.id] && (
                <a class="go" href={WHERE[a.id]} tabindex="-1">
                  Go <span aria-hidden="true">▶</span>
                </a>
              )}
            </li>
          ))
        }
      </ul>

      <div class="foot">
        <p class="keys" aria-hidden="true"><kbd>↑</kbd><kbd>↓</kbd> Select <kbd>Enter</kbd> Go there <kbd>Esc</kbd> Back<span class="wr-keys" data-wardrobe-keys hidden> <kbd>←</kbd><kbd>→</kbd> Wardrobe</span></p>
        {
          /* Dev only (never built): unlock everything to see the platinum. */
          import.meta.env.DEV && (
            <button type="button" class="reset debug" data-debug-all>
              debug: unlock all
            </button>
          )
        }
        <button type="button" class="reset" data-reset>Reset progress</button>
      </div>

      <!-- Reset confirmation, the quit box's little sibling. -->
      <dialog class="confirm" data-confirm aria-labelledby="confirm-title">
        <p class="confirm-kicker">System</p>
        <h2 id="confirm-title" class="confirm-title">Reset all progress?</h2>
        <p class="confirm-line">Every achievement goes back to locked.</p>
        <div class="confirm-actions">
          <button type="button" class="confirm-btn" data-yes>Reset</button>
          <button type="button" class="confirm-btn" data-no autofocus>Keep</button>
        </div>
      </dialog>
    </div>
  </Main>

  <Footer />
</Layout>

<script>
  import { wheelSelect } from "@/scripts/wheelSelect";
  import {
    unlocked,
    isPlatinum,
    reset,
    ACHIEVEMENTS,
    playerTypes,
    classTitle,
    PLAYER_TYPES,
    DUAL_CLASSES,
    PLATINUM_CLASS,
    type PlayerType,
  } from "@/scripts/achievements";
  import { trophyOpen, trophyClose, sfx } from "@/components/home/bootSound";
  import { enteredFrom, soundOn } from "@/scripts/cameFrom";

  // Each class's colour (as on its bar and tags).
  const CLASS_COLOURS: Record<string, string> = {
    scholar: "#ffd27a",
    gamer: "#9aa8ff",
    tinkerer: "#ef8a6b",
    wanderer: "#7fd1c4",
    bard: "#f2a3c8",
  };

  let ctrl: AbortController | null = null;

  function init() {
    const page = document.querySelector<HTMLElement>("[data-ach-page]");
    if (!page || page.dataset.ready) return;
    page.dataset.ready = "1";
    ctrl?.abort();
    ctrl = new AbortController();
    const { signal } = ctrl;
    const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const rows = [...page.querySelectorAll<HTMLElement>("[data-ach]")];

    // Fill in what's been found (it lives in this browser).
    const paint = () => {
      const got = unlocked();
      let n = 0;
      rows.forEach(r => {
        const when = got[r.dataset.ach!];
        r.classList.toggle("is-on", !!when);
        if (when) n++;
        const d = r.querySelector<HTMLElement>("[data-date]")!;
        // The date it was found (blank if it's missing or unreadable).
        const date = when ? new Date(when) : null;
        d.textContent =
          date && !Number.isNaN(date.getTime())
            ? date.toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" })
            : "";
      });
      page.querySelector("[data-found]")!.textContent = String(n);
      page.querySelectorAll<HTMLElement>(".progress-bar span").forEach((b, i) => b.classList.toggle("on", i < n));
      page.querySelector("[data-platinum]")!.classList.toggle("is-on", isPlatinum());
      // Your class: a bar per class (five), and the one you lean towards.
      const t = playerTypes();
      page.querySelectorAll<HTMLElement>("[data-type]").forEach(li => {
        const k = li.dataset.type as keyof typeof t;
        li.querySelector<HTMLElement>(".types-bar span")!.style.width = `${(100 * t[k].got) / t[k].total}%`;
        li.querySelector("[data-type-count]")!.textContent = `${t[k].got}/${t[k].total}`;
      });
      // The title: the platinum's, a dual class, or a single class.
      const title = classTitle();
      dress(title);
      // The wardrobe (platinum only): the portrait wears the chosen look.
      const wardrobe = page.querySelector<HTMLElement>("[data-wardrobe]")!;
      wardrobe.hidden = !title?.plat;
      page.querySelector<HTMLElement>("[data-wardrobe-keys]")!.hidden = !title?.plat;
      if (title?.plat) wear(lookIndex());
      // Found ones first, in the order they're listed; then the rest.
      const list = page.querySelector("[data-ach-list]")!;
      [...rows].sort((a, b) => Number(b.classList.contains("is-on")) - Number(a.classList.contains("is-on")))
        .forEach(r => list.append(r));
    };

    // The wardrobe's looks: the Keeper first, then the five classes and the
    // ten duals. The pick is saved as "classLook" (wiped by Reset).
    type Look = NonNullable<ReturnType<typeof classTitle>>;
    const LOOKS: (Look & { id: string })[] = [
      { ...PLATINUM_CLASS, plat: true, id: "plat" },
      ...(Object.keys(PLAYER_TYPES) as PlayerType[]).map(a => ({ ...PLAYER_TYPES[a], a, id: a })),
      ...Object.entries(DUAL_CLASSES).map(([k, d]) => {
        const [a, b] = k.split("+") as PlayerType[];
        return { ...d, a, b, id: k };
      }),
    ];
    function lookIndex() {
      try {
        return Math.max(0, LOOKS.findIndex(l => l.id === localStorage.getItem("classLook")));
      } catch {
        return 0;
      }
    }
    function wear(i: number) {
      const look = LOOKS[i];
      dressPortrait(look);
      page!.querySelector("[data-look-name]")!.textContent = look.name;
      try {
        if (i === 0) localStorage.removeItem("classLook");
        else localStorage.setItem("classLook", look.id);
      } catch {}
    }
    const cycle = (dir: number) => {
      wear((lookIndex() + dir + LOOKS.length) % LOOKS.length);
      if (soundOn()) sfx([dir > 0 ? 988 : 784], 0, 0.035);
    };
    page.querySelectorAll<HTMLButtonElement>("[data-look]").forEach(b =>
      b.addEventListener("click", () => cycle(Number(b.dataset.look)), { signal })
    );

    // Put a class's name, blurb and portrait on the card.
    function dress(title: ReturnType<typeof classTitle>) {
      page!.querySelector("[data-main-type]")!.textContent = title ? title.name : "Not sure yet";
      page!.querySelector("[data-main-blurb]")!.textContent = title
        ? title.blurb
        : "Find a few things and we'll see what you came here for.";
      dressPortrait(title);
    }
    function dressPortrait(title: ReturnType<typeof classTitle>) {
      // Dress the portrait: the robe in the main class's colour, the sash in
      // the second's; the main prop in the right hand, the second in the
      // left. The platinum is all gold; nothing found yet is a grey "?".
      const portrait = page!.querySelector<HTMLElement>("[data-portrait]")!;
      const colour = (k?: string) => (k ? CLASS_COLOURS[k] : undefined);
      portrait.toggleAttribute("data-none", !title);
      portrait.toggleAttribute("data-plat", !!title?.plat);
      const robe = title?.plat ? "#ffd27a" : colour(title?.a) ?? "#7d82a8";
      portrait.style.setProperty("--robe", robe);
      portrait.style.setProperty("--shade", `color-mix(in srgb, ${robe} 62%, #07081a)`);
      portrait.style.setProperty("--hood", `color-mix(in srgb, ${robe} 78%, #07081a)`);
      portrait.style.setProperty("--trim", title?.plat ? "#fff1c4" : colour(title?.b) ?? `color-mix(in srgb, ${robe} 70%, #fff)`);
      portrait.dataset.r = title?.plat ? "wanderer" : title?.a ?? "";
      portrait.dataset.l = title?.b ?? "";
    }
    paint();
    page.classList.add("is-ready"); // the list deals in (CSS)

    // Coming in: the trophy case's glass door opens.
    if (soundOn() && enteredFrom("/achievements")) trophyOpen();
    // Leaving: the rows slide away as the screen fades, and the case
    // closes.
    document.addEventListener(
      "sys:leaving",
      () => {
        page.classList.add("is-leaving");
        if (soundOn()) trophyClose();
      },
      { signal }
    );

    // A menu: ↑/↓ (or the wheel) move the ▶ cursor.
    let cur = 0;
    const ordered = () => [...page.querySelectorAll<HTMLElement>("[data-ach]")];
    const select = (i: number, focus = true) => {
      const list = ordered();
      cur = (i + list.length) % list.length;
      list.forEach((r, k) => r.classList.toggle("is-active", k === cur));
      if (focus) list[cur].focus({ preventScroll: false });
    };
    select(0, false);
    ordered().forEach(r => {
      r.addEventListener("pointerenter", () => select(ordered().indexOf(r), false), { signal });
      r.addEventListener("focus", () => select(ordered().indexOf(r), false), { signal });
    });
    const confirm = page.querySelector<HTMLDialogElement>("[data-confirm]")!;
    document.addEventListener(
      "keydown",
      e => {
        if (e.altKey || e.ctrlKey || e.metaKey || e.defaultPrevented || confirm.open) return;
        if (e.key === "ArrowDown") {
          e.preventDefault();
          select(cur + 1);
        } else if (e.key === "ArrowUp") {
          e.preventDefault();
          select(cur - 1);
        } else if ((e.key === "ArrowLeft" || e.key === "ArrowRight") && isPlatinum()) {
          // The wardrobe: try on the next look.
          e.preventDefault();
          cycle(e.key === "ArrowRight" ? 1 : -1);
        } else if (e.key === "Enter") {
          // Enter on a locked achievement: go to where it happens.
          const go = ordered()[cur]?.querySelector<HTMLAnchorElement>(".go");
          if (go && !ordered()[cur].classList.contains("is-on")) {
            e.preventDefault();
            go.click();
          }
        }
      },
      { signal }
    );
    wheelSelect(dir => select(cur + dir), signal, () => !confirm.open);

    // Dev only: unlock everything at once (no toasts), then repaint.
    if (import.meta.env.DEV) {
      page.querySelector("[data-debug-all]")?.addEventListener(
        "click",
        () => {
          const now = new Date().toISOString();
          localStorage.setItem("achievements", JSON.stringify(Object.fromEntries(ACHIEVEMENTS.map(a => [a.id, now]))));
          paint();
        },
        { signal }
      );
    }

    // Reset, behind a Yes/No box (arrows move, Enter picks).
    const yes = confirm.querySelector<HTMLButtonElement>("[data-yes]")!;
    const no = confirm.querySelector<HTMLButtonElement>("[data-no]")!;
    page.querySelector("[data-reset]")!.addEventListener(
      "click",
      () => {
        confirm.showModal();
        if (soundOn()) sfx([659.25], 0, 0.04);
      },
      { signal }
    );
    no.addEventListener("click", () => confirm.close(), { signal });
    yes.addEventListener(
      "click",
      () => {
        reset();
        confirm.close();
        paint();
        select(0, false);
        if (soundOn()) sfx([659.25, 440], 0.1, 0.04);
      },
      { signal }
    );
    confirm.addEventListener(
      "keydown",
      e => {
        if (!["ArrowLeft", "ArrowRight", "ArrowUp", "ArrowDown"].includes(e.key)) return;
        e.preventDefault();
        (document.activeElement === yes ? no : yes).focus();
        if (soundOn()) sfx([880], 0, 0.03);
      },
      { signal }
    );
    confirm.addEventListener("click", e => e.target === confirm && confirm.close(), { signal });

    // Another tab (or page) unlocked something: keep up.
    document.addEventListener("ach:unlock", paint, { signal });
    void ACHIEVEMENTS;
    void reduce;

    document.addEventListener("astro:before-swap", () => ctrl?.abort(), { signal, once: true });
  }
  document.addEventListener("astro:page-load", init);
</script>

<style>
  .ach-page {
    --amber: #ffd27a;
    --dusk: #9aa0d6;
    --moon: #efecdc;
  }

  /* ── progress ──────────────────────────────────────────────── */
  .progress {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem 1.2rem;
    margin: 0.5rem 0 1.5rem;
    font-family: var(--font-pixel), monospace;
    font-variant-ligatures: none;
  }
  .progress-count {
    margin: 0;
    color: var(--moon);
    font-size: 1rem;
  }
  .progress-count span {
    color: var(--amber);
  }
  .progress-bar {
    display: flex;
    gap: 3px;
    padding: 3px;
    border: 2px solid rgb(154 160 214 / 0.45);
  }
  .progress-bar span {
    width: 8px;
    height: 12px;
    background: rgb(154 160 214 / 0.15);
  }
  .progress-bar span:global(.on) {
    background: var(--amber);
  }

  /* ── your class ─────────────────────────────────────────────── */
  /* Text and bars on the left, the portrait on the right. */
  .types {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 9rem;
    gap: 1.25rem;
    align-items: center;
    margin: 0 0 1.5rem;
    padding: 0.9rem 1.1rem;
    border: 3px solid rgb(154 160 214 / 0.35);
    border-radius: 6px;
    background: rgb(12 14 42 / 0.5);
    font-family: var(--font-pixel), monospace;
    font-variant-ligatures: none;
  }
  /* The wardrobe (platinum only): ◀ look name ▶ under the portrait. */
  .types-portrait {
    display: grid;
    gap: 0.45rem;
  }
  .wardrobe {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.25rem;
  }
  .wardrobe[hidden] {
    display: none;
  }
  .wr-name {
    color: #ffd27a;
    font-size: 0.62rem;
    line-height: 1.3;
    text-align: center;
    /* Room for two lines, so a long name doesn't make the card jump. */
    min-height: 2.6em;
    display: grid;
    place-items: center;
  }
  .wr-btn {
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    padding: 0;
    border: 2px solid rgb(255 210 122 / 0.45);
    border-radius: 3px;
    background: rgb(5 6 20 / 0.5);
    color: #ffd27a;
    font-size: 0.6rem;
    line-height: 1;
    cursor: pointer;
  }
  .wr-btn:hover,
  .wr-btn:focus-visible {
    outline: none;
    border-color: #ffd27a;
    background: rgb(255 210 122 / 0.15);
  }
  /* Shorter bars (so the portrait has room). */
  .types-bars {
    max-width: 24rem;
  }
  @media (max-width: 640px) {
    .types {
      grid-template-columns: minmax(0, 1fr) 6.5rem;
      gap: 0.9rem;
    }
  }
  .types-main {
    margin: 0;
    color: var(--moon);
    font-size: 1.15rem;
    font-weight: 600;
  }
  .types-kicker {
    margin-right: 0.5rem;
    color: var(--dusk);
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }
  .types-blurb {
    margin: 0.3rem 0 0.8rem;
    color: rgb(239 236 220 / 0.75);
    font-family: var(--font-console), system-ui, sans-serif;
    font-size: 0.92rem;
  }
  .types-bars {
    display: grid;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .types-bars li {
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr) 2.5rem;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.8rem;
  }
  .types-name {
    color: var(--dusk);
  }
  .types-bar {
    height: 10px;
    border: 2px solid rgb(154 160 214 / 0.45);
  }
  .types-bar span {
    display: block;
    width: 0;
    height: 100%;
    background: var(--c, var(--amber));
    transition: width 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .types-count {
    color: var(--moon);
    text-align: right;
  }
  /* A colour per class, on the bars and the tags. */
  [data-type="scholar"],
  .t-scholar {
    --c: #ffd27a;
  }
  [data-type="gamer"],
  .t-gamer {
    --c: #9aa8ff;
  }
  [data-type="tinkerer"],
  .t-tinkerer {
    --c: #ef8a6b;
  }
  [data-type="wanderer"],
  .t-wanderer {
    --c: #7fd1c4;
  }
  [data-type="bard"],
  .t-bard {
    --c: #f2a3c8;
  }
  .ach-type {
    display: inline-block;
    margin-left: 0.6rem;
    padding: 0.05rem 0.4rem;
    border: 1px solid var(--c);
    border-radius: 3px;
    color: var(--c);
    font-size: 0.6rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-shadow: none;
    vertical-align: middle;
  }
  /* "Go ▶": straight to where a locked achievement happens (found ones
     don't need it). Enter on a selected row follows it too. */
  .go {
    padding: 0.3rem 0.6rem;
    border: 2px solid rgb(154 160 214 / 0.45);
    border-radius: 3px;
    color: var(--dusk) !important;
    font-family: var(--font-pixel), monospace;
    font-size: 0.75rem;
    text-decoration: none;
    white-space: nowrap;
  }
  .go:hover,
  .ach:global(.is-active) .go {
    border-color: var(--amber);
    color: var(--amber) !important;
  }
  .ach:global(.is-on) .go {
    display: none;
  }
  .ach:has(.go) {
    grid-template-columns: auto minmax(0, 1fr) auto auto;
  }
  @media (max-width: 640px) {
    .ach:has(.go) {
      grid-template-columns: auto minmax(0, 1fr);
    }
    .go {
      grid-column: 2;
      justify-self: start;
    }
  }
  .credits-link {
    color: var(--amber) !important;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* ── the windows (platinum + each achievement) ─────────────── */
  .platinum,
  .ach {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 1rem;
    padding: 0.8rem 1.1rem;
    border: 3px solid rgb(154 160 214 / 0.35);
    border-radius: 6px;
    background: linear-gradient(180deg, rgb(32 38 104 / 0.55), rgb(14 17 56 / 0.55));
    box-shadow:
      inset 0 0 0 2px rgb(5 6 20 / 0.7),
      5px 5px 0 rgb(3 4 14 / 0.7);
  }
  .icon {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 3px;
    background: rgb(5 6 20 / 0.6);
    color: rgb(154 160 214 / 0.55);
  }
  .icon :global(svg) {
    width: 1.6rem;
    height: 1.6rem;
  }
  .text {
    min-width: 0;
  }
  .title {
    margin: 0;
    color: var(--moon);
    font-family: var(--font-pixel), monospace;
    font-size: 1.1rem;
