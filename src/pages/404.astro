---
/**
 * 404 as a "Game over" screen: the page you wanted isn't in this world.
 * Continue? Yes goes back to the main menu, No (try it) refuses politely
 * and counts down anyway, the way old arcade continue screens do.
 */
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import { getRelativeLocaleUrl } from "astro:i18n";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const home = getRelativeLocaleUrl(locale, "");
---

<Layout title={`Game over | ${config.site.title}`}>
  <Header name="Game over" />

  <main id="main-content" class="over" data-over data-home={home}>
    <p class="kicker">Error 404</p>
    <h1 class="title">Game over</h1>
    <p class="line">This page isn't in this world. Maybe it never was.</p>

    <p class="continue">Continue?</p>
    <p class="count" data-count aria-live="polite">9</p>

    <div class="choices">
      <a href={home} class="choice is-active" data-choice>
        <span class="marker" aria-hidden="true">▶</span> Yes
      </a>
      <button type="button" class="choice" data-choice data-no>
        <span class="marker" aria-hidden="true">▶</span> No
      </button>
    </div>
    <p class="note" data-note aria-live="polite"></p>
  </main>
</Layout>

<script>
  import { navigate } from "astro:transitions/client";
  import { glitch, gameOver, continueCoin, sfx } from "@/components/home/bootSound";
  import { soundOn } from "@/scripts/cameFrom";

  let stop: (() => void) | null = null;

  function initOver() {
    const root = document.querySelector<HTMLElement>("[data-over]");
    if (!root || root.dataset.ready) return;
    root.dataset.ready = "1";
    const home = root.dataset.home || "/";
    const count = root.querySelector<HTMLElement>("[data-count]")!;
    const note = root.querySelector<HTMLElement>("[data-note]")!;
    const choices = [...root.querySelectorAll<HTMLElement>("[data-choice]")];
    const no = root.querySelector<HTMLButtonElement>("[data-no]")!;
    const ac = new AbortController();
    let n = 9;
    let cur = 0;

    // Game over: the falling jingle as the screen comes up.
    if (soundOn()) gameOver();
    // Continue (Yes, or the countdown running out): a coin, the site's
    // fade, then the main menu.
    let continuing = false;
    const cont = () => {
      if (continuing) return;
      continuing = true;
      window.clearInterval(timer);
      if (soundOn()) continueCoin();
      if (matchMedia("(prefers-reduced-motion: reduce)").matches) return void navigate(home);
      document.documentElement.classList.add("sys-leaving");
      window.setTimeout(() => navigate(home), 420);
    };
    choices[0].addEventListener(
      "click",
      e => {
        if ((e as MouseEvent).metaKey || (e as MouseEvent).ctrlKey) return;
        e.preventDefault();
        cont();
      },
      { signal: ac.signal }
    );

    // The continue countdown. At zero it continues anyway.
    const timer = window.setInterval(() => {
      n -= 1;
      count.textContent = String(Math.max(n, 0));
      count.classList.remove("tick");
      void count.offsetWidth;
      count.classList.add("tick");
      if (n <= 0) {
        window.clearInterval(timer);
        note.textContent = "Continuing anyway.";
        window.setTimeout(cont, 600);
      }
    }, 1000);

    const select = (i: number) => {
      const next = (i + choices.length) % choices.length;
      if (next !== cur && soundOn()) sfx([880], 0, 0.03);
      cur = next;
      choices.forEach((c, j) => c.classList.toggle("is-active", j === cur));
    };
    choices.forEach((c, i) => {
      c.addEventListener("pointerenter", () => select(i), { signal: ac.signal });
      c.addEventListener("focus", () => select(i), { signal: ac.signal });
    });
    const lines = ["Not an option.", "Still no.", "Nice try. It's counting down."];
    let tries = 0;
    let falling = false;
    no.addEventListener(
      "click",
      () => {
        if (falling) return;
        // Refuse one time too many and the world gives way: you no-clip
        // out of it, into the Backrooms.
        if (tries >= lines.length) {
          falling = true;
          window.clearInterval(timer);
          note.textContent = "No.";
          root.classList.add("is-falling");
          if (soundOn()) glitch();
          window.setTimeout(() => (location.href = "/backrooms"), 900);
          return;
        }
        note.textContent = lines[tries++];
      },
      { signal: ac.signal }
    );
    document.addEventListener(
      "keydown",
      e => {
        if (e.key === "ArrowLeft" || e.key === "ArrowUp") select(cur - 1);
        else if (e.key === "ArrowRight" || e.key === "ArrowDown") select(cur + 1);
        else if (e.key === "Enter" && !choices.includes(document.activeElement as HTMLElement)) choices[cur].click();
      },
      { signal: ac.signal }
    );

    stop = () => {
      ac.abort();
      window.clearInterval(timer);
    };
  }

  document.addEventListener("astro:page-load", initOver);
  document.addEventListener("astro:before-swap", () => {
    stop?.();
    stop = null;
  });
</script>

<style>
  /* Falling out of the world: the screen jitters, splits its colours and
     tears sideways, then cuts away. */
  .over:global(.is-falling) {
    animation: fall-glitch 0.9s steps(1) forwards;
  }
  @keyframes fall-glitch {
    0% {
      transform: translate(0, 0);
      filter: none;
    }
    10% {
      transform: translate(-6px, 2px) skewX(-4deg);
      filter: hue-rotate(90deg) saturate(3);
    }
    20% {
      transform: translate(8px, -3px);
      filter: invert(1);
    }
    30% {
      transform: translate(-3px, 5px) scaleY(1.1);
      filter: none;
      clip-path: inset(20% 0 30% 0);
    }
    45% {
      transform: translate(12px, 0) skewX(8deg);
      filter: hue-rotate(200deg) contrast(2);
      clip-path: inset(0 0 55% 0);
    }
    60% {
      transform: translate(-10px, -4px);
      filter: invert(1) blur(1px);
      clip-path: inset(40% 0 10% 0);
    }
    75% {
      transform: translate(0, 0) scale(1.4, 0.02);
      filter: brightness(3);
      clip-path: none;
    }
    90%,
    100% {
      transform: scale(0, 0);
      opacity: 0;
    }
  }
  .over {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    padding: 3rem 1rem 4rem;
    font-family: var(--font-pixel), monospace;
    font-variant-ligatures: none;
    text-align: center;
    text-shadow: 0.07em 0.07em 0 rgb(5 6 20 / 0.9);
  }
  .kicker {
    margin: 0;
    color: var(--muted-foreground);
    font-size: 0.8rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
  }
  .title {
    margin: 0;
    color: #ff6f61;
    font-size: clamp(3rem, 11vw, 6.5rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.04em;
    text-shadow:
      0.06em 0.06em 0 rgb(5 6 20 / 0.95),
      0 0 30px rgb(255 111 97 / 0.35);
    animation: drop-in 0.6s cubic-bezier(0.3, 1.4, 0.5, 1) both;
  }
  @keyframes drop-in {
    from {
      opacity: 0;
      transform: translateY(-40px);
    }
  }
  .line {
    margin: 0.6rem 0 0;
    color: var(--muted-foreground);
  }
  .continue {
    margin: 2.2rem 0 0;
    font-size: 1.4rem;
    animation: blink 1.1s steps(1) infinite;
  }
  @keyframes blink {
    60% {
      opacity: 0;
    }
  }
  .count {
    margin: 0;
    color: var(--accent);
    font-size: 3rem;
    line-height: 1;
  }
  .count:global(.tick) {
    animation: tick 0.3s ease-out;
  }
  @keyframes tick {
    from {
      transform: scale(1.35);
    }
  }
  .choices {
    display: flex;
    gap: 2.5rem;
    margin-top: 1.4rem;
  }
  .choice {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    border: 0;
    background: none;
    color: rgb(239 236 220 / 0.55);
    font: inherit;
    font-size: 1.5rem;
    text-decoration: none;
    text-shadow: inherit;
    cursor: pointer;
  }
  .choice:focus-visible {
    outline: none;
  }
  .marker {
    color: var(--accent);
    font-size: 0.8rem;
    opacity: 0;
  }
  .choice.is-active {
    color: var(--accent);
  }
  .choice.is-active .marker {
    opacity: 1;
  }
  .note {
    min-height: 1.5em;
    margin: 1rem 0 0;
    color: var(--muted-foreground);
  }
  @media (prefers-reduced-motion: reduce) {
    .title,
    .continue,
    .count:global(.tick) {
      animation: none;
    }
  }
</style>
