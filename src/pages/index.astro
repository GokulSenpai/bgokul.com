---
/**
 * Home: the site's main menu, like a game's title screen. Your name types
 * out, the menu is the site's navigation (so no top bar here), a pixel-art
 * night scene plays behind it (see components/home/NightScene.astro), and a loading-screen "Tip" line rotates along the bottom.
 * Arrow keys move through the menu and Enter opens the selected item.
 *
 * Two easter eggs:
 *  - Boot sequence: plays once on a visitor's first visit (localStorage),
 *    old-console style, ending on "Press any key". Pressing 0 on the menu replays it.
 *  - Quit: refuses to quit, harder each time, then fakes a shutdown.
 *
 *
 */
import { getRelativeLocaleUrl } from "astro:i18n";
import { Font } from "astro:assets";
import NightScene from "@/components/home/NightScene.astro";
import SceneSwitch from "@/components/home/SceneSwitch.astro";
import Layout from "@/layouts/Layout.astro";
import TypewriterHeading from "@/components/TypewriterHeading.astro";
import ComeBackTitle from "@/components/ComeBackTitle.astro";
import { homeTips } from "@/data/homeTips";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const homePath = getRelativeLocaleUrl(locale, "");

const menu = [
  { label: "Start", hint: "Portfolio: games, stories and code", href: "/portfolio" },
  { label: "Resume", hint: "Written as patch notes", href: "/resume" },
  { label: "Journal", hint: "Blog", href: getRelativeLocaleUrl(locale, "blog") },
  { label: "Contact", hint: "Business card", href: "/contact" },
  // The hint shows the visitor's progress (filled in by script: it lives
  // in their browser).
  { label: "Achievements", hint: "Things to find", href: "/achievements" },
];

// The boot logo: a 5x5 pixel "G".
const logoGrid = [".####", "#....", "#.###", "#...#", ".###."];
let cell = 0;
const logoCells = logoGrid.flatMap(row => [...row].map((c, col) => ({ i: c === "#" ? cell++ : -1, col })));

// Save files the boot screen "finds" (the Portfolio's sections).
const saveCount = 4;
const year = new Date().getFullYear();

// The boot screen plays on the first visit only (and after the Quit gag's
// fake shutdown, and on 0). true plays it every time home loads: for
// testing only.
const ALWAYS_BOOT = false;
---

<Layout>
  <Fragment slot="head">
    <Font cssVariable="--font-console" preload={[{ subset: "latin", weight: 600, style: "normal" }]} />
    <Font cssVariable="--font-pixel" preload={[{ subset: "latin", weight: 500, style: "normal" }]} />
  </Fragment>

  <!-- First visit? Mark it before paint so the boot screen covers the menu. -->
  <script is:inline define:vars={{ always: ALWAYS_BOOT }}>
    try {
      if (always || !localStorage.getItem("bootSeen")) {
        // Seen as soon as it starts: leaving mid-boot doesn't replay it.
        localStorage.setItem("bootSeen", "1");
        // Browsers block sound until the visitor presses something. If that
        // hasn't happened yet (and sound isn't switched off), start on a
        // "standby" screen: pressing any button powers on, with the jingle.
        const canPlay = navigator.userActivation ? navigator.userActivation.hasBeenActive : false;
        const soundOff = localStorage.getItem("titleSound") === "off";
        document.documentElement.dataset.boot = canPlay || soundOff ? "" : "standby";
      }
    } catch {}
  </script>

  <div class="boot" data-boot-screen aria-hidden="true">
    <!-- Boot screen (first visit only): power on, pixel logo, memory check, Press start. -->
    <div class="standby">
      <span class="led"></span>
      <p class="standby-text">
        <span class="press-key">Press any key to power on</span>
        <span class="press-touch">Tap to power on</span>
      </p>
      <p class="standby-sub">Best with sound</p>
    </div>
    <div class="crt"></div>
    <div class="boot-inner">
      <div class="mark">
        {logoCells.map(({ i, col }) => (i < 0 ? <span /> : <span class="px" style={`--i:${i}; --c:${col}`} />))}
      </div>
      <p class="word">bgokul</p>
      <p class="sub">Games and stories</p>
      <div class="legal">
        <p>© {year} Gokul Naga Sai</p>
        <p>Licensed by absolutely no one</p>
      </div>
      <p class="memory">
        <span class="check">Checking memory card…</span>
        <span class="found">{saveCount} save files found</span>
      </p>
      <p class="press">
        <span class="press-key">Press any key</span>
        <span class="press-touch">Tap to start</span>
      </p>
    </div>
    <div class="scan"></div>
  </div>

  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="title-screen"
    data-title-screen
  >
    <!-- Pixel-art night scene: sea, moon, a lighthouse sweeping its beam -->
    <div class="bg" aria-hidden="true">
      <NightScene />
      <div class="shade"></div>
    </div>

    <div class="content">
      <div class="logo">
        <TypewriterHeading class="whitespace-nowrap" />
      </div>
      <p class="tagline">
        I make games, write stories, and spend an unreasonable amount of time
        convincing myself I should learn yet another creative skill.
      </p>

      <nav class="menu" aria-label="Main menu">
        <ul>
          {menu.map((m, i) => (
            <li style={`--n:${i}`}>
              <a href={m.href} class:list={["item", { "is-active": i === 0 }]} data-item>
                <span class="marker" aria-hidden="true">▶</span>
                <span class="label">{m.label}</span>
                <span class="hint">{m.hint}</span>
              </a>
            </li>
          ))}
          <li style={`--n:${menu.length}`}>
            <button type="button" class="item item--quit" data-item data-quit>
              <span class="marker" aria-hidden="true">▶</span>
              <span class="label">Quit</span>
              <span class="hint" data-quit-hint>Exit to desktop</span>
            </button>
          </li>
        </ul>
      </nav>
    </div>

    <div class="bar">
      <p class="tip">
        <span class="tip-label">Tip</span>
        <span class="tip-text" data-tip data-tips={JSON.stringify(homeTips)} aria-live="polite">{homeTips[0]}</span>
      </p>
      <div class="bar-end">
        <button type="button" class="sound" data-sound aria-pressed="false">
          <span class="sound-icon" aria-hidden="true"><span></span><span></span><span></span></span>
          <span data-sound-label>Sound off</span>
        </button>
        <p class="build">Build 4.0</p>
      </div>
    </div>

    <!-- Top right: the platinum's day/night switch (hidden until then), and
         ambient mode (hide all the UI, go fullscreen, just the scene). -->
    <div class="hud-tr">
      <SceneSwitch />
      <button type="button" class="ambient-btn" data-ambient title="Hide everything and go fullscreen. Esc to exit.">
        <span class="amb-icon" aria-hidden="true">⛶</span> Ambient mode
      </button>
    </div>
    <button type="button" class="ambient-exit" data-ambient-exit aria-label="Exit ambient mode">✕</button>
    <p class="ambient-hint" data-ambient-hint aria-live="polite"></p>

    <!-- Quit confirmation, which never quite agrees to quit -->
    <dialog class="quit" data-quit-dialog aria-labelledby="quit-title">
      <p class="quit-kicker">System</p>
      <h2 id="quit-title" class="quit-title">Quit to desktop?</h2>
      <p class="quit-line" data-quit-line aria-live="polite">Any unsaved progress will be lost.</p>
      <div class="quit-actions">
        <button type="button" class="quit-btn" data-quit-yes>Yes</button>
        <button type="button" class="quit-btn quit-btn--main" data-quit-no autofocus>No</button>
      </div>
    </dialog>

    <!-- The fake shutdown -->
    <div class="off" data-off aria-hidden="true">
      <p class="off-text" data-off-text></p>
    </div>
  </main>
  <ComeBackTitle />
</Layout>

<script>
  import * as music from "@/components/home/titleMusic";
  import { playBootSound, stopBootSound, sfx } from "@/components/home/bootSound";
  import { unlock, count, has, isPlatinum, sawBoot, ACHIEVEMENTS } from "@/scripts/achievements";
  import { navigate } from "astro:transitions/client";
  import { wheelSelect } from "@/scripts/wheelSelect";

  let cleanup: ((to?: string) => void) | null = null;

  // Each menu item has its own note when the theme is playing.
  const MENU_NOTES = [659.25, 783.99, 880, 1046.5, 587.33];

  const QUIT_LINES = [
    "Quit? I'm not a quitter.",
    "I get shit done. Pick something else.",
    "Quitting isn't in this build. I checked the patch notes.",
    "That's four tries. Imagine putting this energy into a game jam.",
    "Fine. You asked for it.",
  ];
  const YES_LABELS = ["Yes", "Yes, really", "YES", "Please", "…"];
  const AFTER_LINES = ["We've been through this.", "Still here. Still not quitting.", "Nice try."];

  function initTitle() {
    const root = document.querySelector<HTMLElement>("[data-title-screen]");
    if (!root || root.dataset.ready) return;
    root.dataset.ready = "1";

    // Remember home as the "back" target (kept from the old home page).
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    sessionStorage.setItem("backUrl", root.dataset.homePath ?? baseRoot);

    const ac = new AbortController();
    const { signal } = ac;
    const timers: number[] = [];
    const later = (fn: () => void, ms: number) => timers.push(window.setTimeout(fn, ms));
    const html = document.documentElement;
    const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;

    // ── Boot sequence ────────────────────────────────────────────
    const boot = document.querySelector<HTMLElement>("[data-boot-screen]")!;
    let bootState: "off" | "standby" | "playing" | "ready" = "off";
    const BOOT_MS = reduce ? 0 : 4600;

    const bootReady = () => {
      if (bootState !== "playing") return;
      bootState = "ready";
      boot.classList.add("is-ready");
    };
    const playBoot = () => {
      html.dataset.boot = "";
      boot.classList.remove("is-ready", "is-leaving");
      // Restart the CSS animations.
      boot.style.display = "none";
      void boot.offsetWidth;
      boot.style.display = "";
      bootState = "playing";
      root.inert = true;
      if (wantSound()) playBootSound();
      later(bootReady, BOOT_MS);
      sawBoot(); // the second time is "Encore"
    };
    // Standby -> power on: the boot animation starts now, with the jingle.
    const powerOn = () => {
      html.dataset.boot = "";
      bootState = "playing";
      if (wantSound()) playBootSound();
      later(bootReady, BOOT_MS);
      sawBoot();
    };
    const leaveBoot = () => {
      bootState = "off";
      root.inert = false;
      try {
        localStorage.setItem("bootSeen", "1");
      } catch {}
      sfx([880, 1318.51, 1760], 0.11, 0.07); // A E A: Press start
      if (wantSound()) startSound();
      boot.classList.add("is-leaving");
      root.classList.add("is-entering");
      // The name starts its cycle fresh, from "Gokul Naga Sai", as the menu appears.
      document.dispatchEvent(new Event("typewriter:restart"));
      later(() => {
        delete html.dataset.boot;
        boot.classList.remove("is-leaving", "is-ready");
        items[cur]?.focus({ preventScroll: true });
      }, reduce ? 0 : 1300);
      later(() => root.classList.remove("is-entering"), reduce ? 0 : 2600);
    };
    // Any press: skip to "Press start", then a second press starts.
    const bootPress = (e: Event) => {
      if (bootState === "off") return;
      e.preventDefault();
      e.stopImmediatePropagation();
      if (bootState === "standby") powerOn();
      else if (bootState === "playing") {
        bootState = "ready";
        boot.classList.add("is-ready");
      } else leaveBoot();
    };
    if (html.dataset.boot === "standby") {
      bootState = "standby";
      root.inert = true;
    } else if ("boot" in html.dataset) {
      bootState = "playing";
      root.inert = true;
      if (wantSound()) playBootSound();
      later(bootReady, BOOT_MS);
      sawBoot();
    } else if (!reduce) {
      // Arriving from another page: the scene fades up and the menu rises
      // in, the same entrance as after the boot screen, just sooner.
      root.classList.add("is-entering", "is-arriving");
      later(() => root.classList.remove("is-entering", "is-arriving"), 1700);
    }
    boot.addEventListener("pointerdown", bootPress, { signal });
    document.addEventListener(
      "keydown",
      e => {
        if (bootState !== "off" && !e.repeat && !["Tab", "Shift", "Alt", "Control", "Meta"].includes(e.key)) bootPress(e);
      },
      { signal, capture: true }
    );

    // ── Menu ─────────────────────────────────────────────────────
    const items = [...root.querySelectorAll<HTMLElement>("[data-item]")];
    // Achievements: the hint shows this visitor's progress.
    const achHint = root.querySelector<HTMLElement>('a[href="/achievements"] .hint');
    const showProgress = () => {
      if (achHint) achHint.textContent = isPlatinum() ? "All found ★" : `${count()} of ${ACHIEVEMENTS.length} found`;
    };
    showProgress();
    // …and keep it current: achievements found right here on the menu (the
    // keeper, ripples, a wish, Quit…) count up straight away.
    document.addEventListener("ach:unlock", showProgress, { signal });
    document.addEventListener("ach:reset", showProgress, { signal });
    let cur = 0;

    // The lighthouse beam swings onto the selected item, then goes back
    // to sweeping after a few idle seconds.
    let aimTimer = 0;
    const aimAt = (el: HTMLElement | null, hold = 5000) => {
      window.clearTimeout(aimTimer);
      let detail: { x: number; y: number } | null = null;
      if (el) {
        const r = el.querySelector(".label")!.getBoundingClientRect();
        detail = { x: r.left + r.width / 2, y: r.top + r.height / 2 };
        aimTimer = window.setTimeout(() => aimAt(null), hold);
      }
      document.dispatchEvent(new CustomEvent("night:aim", { detail }));
    };

    // One highlighted item at a time, moved by mouse, focus or arrows.
    const select = (i: number, focus = false) => {
      const prev = cur;
      cur = (i + items.length) % items.length;
      items.forEach((el, j) => el.classList.toggle("is-active", j === cur));
      if (focus) items[cur].focus();
      aimAt(items[cur]);
      if (prev !== cur) music.bell(MENU_NOTES[cur], 0.03);
    };
    items.forEach((el, i) => {
      el.addEventListener("pointerenter", () => select(i), { signal });
      el.addEventListener("focus", () => select(i), { signal });
    });

    // Choosing an item (not Quit): a confirm chime, the item blinks like an
    // old game menu, the scene fades to black, then the next page opens.
    let going = false;
    items.forEach((el, i) => {
      if (!(el instanceof HTMLAnchorElement)) return;
      el.addEventListener(
        "click",
        e => {
          if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0) return;
          e.preventDefault();
          if (going) return;
          going = true;
          select(i);
          window.clearTimeout(aimTimer);
          sfx([880, 1318.51], 0.08, 0.06);
          // Loading into a section: the theme fades out (it carries on to
          // the save screen, which is part of the menu).
          if (!music.isMenuPath(new URL(el.href).pathname)) music.stop();
          el.classList.add("is-chosen");
          root.classList.add("is-going");
          later(() => navigate(el.href), reduce ? 0 : 750);
        },
        { signal }
      );
    });

    root.querySelector(".menu")!.addEventListener("pointerleave", () => aimAt(items[cur], 1200), { signal });
    // The mouse wheel moves through the menu too (not during the boot
    // screen, the quit box, the fake shutdown or ambient mode).
    wheelSelect(
      dir => select(cur + dir, true),
      signal,
      () => bootState === "off" && !dialog.open && !root.classList.contains("is-off") && !ambient
    );

    // ── Ambient mode ─────────────────────────────────────────────
    // Hides the name, menu and panels, goes fullscreen, and leaves just the
    // living scene (and the music). Esc, leaving fullscreen, or the ✕ on
    // touch screens brings everything back.
    const ambBtn = root.querySelector<HTMLButtonElement>("[data-ambient]")!;
    const ambExit = root.querySelector<HTMLButtonElement>("[data-ambient-exit]")!;
    const ambHint = root.querySelector<HTMLElement>("[data-ambient-hint]")!;
    const content = root.querySelector<HTMLElement>(".content")!;
    let ambient = false;
    let seaTimer = 0;
    const enterAmbient = () => {
      if (ambient) return;
      ambient = true;
      // A whole minute of just watching: an achievement.
      seaTimer = window.setTimeout(() => ambient && unlock("sea"), 60000);
      timers.push(seaTimer);
      root.classList.add("is-ambient");
      html.classList.add("ambient");
      content.inert = true;
      aimAt(null);
      document.documentElement.requestFullscreen?.().catch(() => {});
      ambHint.textContent = matchMedia("(hover: none)").matches ? "Tap ✕ to exit" : "Press Esc to exit";
      ambHint.classList.remove("is-shown");
      void ambHint.offsetWidth;
      ambHint.classList.add("is-shown");
    };
    const exitAmbient = () => {
      if (!ambient) return;
      ambient = false;
      window.clearTimeout(seaTimer);
      root.classList.remove("is-ambient");
      html.classList.remove("ambient");
      content.inert = false;
      ambHint.classList.remove("is-shown");
      if (document.fullscreenElement) document.exitFullscreen().catch(() => {});
      ambBtn.focus({ preventScroll: true });
    };
    ambBtn.addEventListener("click", enterAmbient, { signal });
    ambExit.addEventListener("click", exitAmbient, { signal });
    document.addEventListener(
      "fullscreenchange",
      () => {
        if (!document.fullscreenElement) exitAmbient();
      },
      { signal }
    );
    document.addEventListener(
      "keydown",
      e => {
        if (ambient && e.key === "Escape") exitAmbient();
      },
      { signal }
    );

    // ── Title theme ──────────────────────────────────────────────
    const soundBtn = root.querySelector<HTMLButtonElement>("[data-sound]")!;
    const soundLabel = root.querySelector<HTMLElement>("[data-sound-label]")!;
    function wantSound() {
      try {
        return localStorage.getItem("titleSound") !== "off";
      } catch {
        return true;
      }
    }
    const showSound = () => {
      const on = music.isPlaying();
      soundBtn.setAttribute("aria-pressed", String(on));
      soundBtn.classList.toggle("is-on", on);
      soundLabel.textContent = on ? "Sound on" : "Sound off";
    };
    function startSound() {
      music.start();
      showSound();
    }
    soundBtn.addEventListener(
      "click",
      () => {
        const on = !music.isPlaying();
        if (on) music.start();
        else music.stop();
        try {
          localStorage.setItem("titleSound", on ? "on" : "off");
        } catch {}
        showSound();
        // Off: a party pooper. Back on again after that: a change of heart.
        if (!on) unlock("party-pooper");
        else if (has("party-pooper")) unlock("change-of-heart");
      },
      { signal }
    );
    // No boot screen? Start the theme on the first key press or tap
    // (browsers need one), unless it was switched off before.
    const firstTouch = (e: Event) => {
      if (bootState !== "off" || music.isPlaying() || !wantSound()) return;
      if ((e.target as HTMLElement).closest("[data-sound]")) return;
      startSound();
    };
    document.addEventListener("pointerdown", firstTouch, { signal, once: true });
    document.addEventListener("keydown", firstTouch, { signal, once: true });
    // Coming back to home from another page: the browser already allows
    // sound (the visitor has clicked on the site), so fade the theme
    // straight in if it's on, without waiting for another press.
    if (bootState === "off" && wantSound() && navigator.userActivation?.hasBeenActive) startSound();

    // ── Poking the scene: ripples on the sea, shooting stars in the sky ──
    root.addEventListener(
      "pointerdown",
      e => {
        if ((e.target as HTMLElement).closest("a, button, dialog, .tagline, .logo")) return;
        document.dispatchEvent(new CustomEvent("night:poke", { detail: { x: e.clientX, y: e.clientY } }));
        music.bell(undefined, 0.04);
      },
      { signal }
    );

    const dialog = root.querySelector<HTMLDialogElement>("[data-quit-dialog]")!;
    document.addEventListener(
      "keydown",
      e => {
        if (e.altKey || e.ctrlKey || e.metaKey || dialog.open || root.classList.contains("is-off") || ambient) return;
        if (e.key === "ArrowDown") {
          e.preventDefault();
          select(cur + 1, true);
        } else if (e.key === "ArrowUp") {
          e.preventDefault();
          select(cur - 1, true);
        } else if (e.key === "Enter" && !items.includes(document.activeElement as HTMLElement)) {
          items[cur].click();
        } else if (e.key === "0" && !(e.target as HTMLElement).closest("input, textarea")) {
          playBoot();
        }
      },
      { signal }
    );

    // ── Quit ─────────────────────────────────────────────────────
    const quitBtn = root.querySelector<HTMLButtonElement>("[data-quit]")!;
    const quitHint = root.querySelector<HTMLElement>("[data-quit-hint]")!;
    const line = dialog.querySelector<HTMLElement>("[data-quit-line]")!;
    const yes = dialog.querySelector<HTMLButtonElement>("[data-quit-yes]")!;
    const no = dialog.querySelector<HTMLButtonElement>("[data-quit-no]")!;
    const offText = root.querySelector<HTMLElement>("[data-off-text]")!;
    let tries = 0;
    let shutdownDone = false;
    let after = 0;

    const say = (text: string) => {
      line.textContent = text;
      dialog.classList.remove("is-shake");
      void dialog.offsetWidth;
      dialog.classList.add("is-shake");
    };

    quitBtn.addEventListener(
      "click",
      () => {
        tries = 0;
        yes.textContent = YES_LABELS[0];
        line.textContent = shutdownDone
          ? AFTER_LINES[after++ % AFTER_LINES.length]
          : "Any unsaved progress will be lost.";
        yes.hidden = shutdownDone;
        no.textContent = shutdownDone ? "Fine" : "No";
        dialog.showModal();
        sfx([659.25], 0, 0.05); // E: the quit box opens
        unlock("rage-quit");
      },
      { signal }
    );
    no.addEventListener("click", () => dialog.close(), { signal });
    // Arrows move between the buttons (like any game's Yes/No box); Enter
    // or Space press the one selected (the browser does that part).
    dialog.addEventListener(
      "keydown",
      e => {
        if (!["ArrowLeft", "ArrowRight", "ArrowUp", "ArrowDown"].includes(e.key)) return;
        e.preventDefault();
        const btns = [yes, no].filter(b => !b.hidden);
        const i = btns.indexOf(document.activeElement as HTMLButtonElement);
        const dir = e.key === "ArrowLeft" || e.key === "ArrowUp" ? -1 : 1;
        const next = btns[(Math.max(i, 0) + dir + btns.length) % btns.length];
        if (next !== document.activeElement) {
          next.focus();
          sfx([880], 0, 0.03);
        }
      },
      { signal }
    );
    dialog.addEventListener(
      "click",
      e => {
        if (e.target === dialog) dialog.close();
      },
      { signal }
    );
    dialog.addEventListener("close", () => quitBtn.focus({ preventScroll: true }), { signal });

    yes.addEventListener(
      "click",
      () => {
        const text = QUIT_LINES[tries];
        tries++;
        sfx([[587.33, 523.25, 440, 392, 329.63][tries - 1] ?? 329.63], 0, 0.05); // falling A minor, each refusal
        if (tries < QUIT_LINES.length) {
          say(text);
          yes.textContent = YES_LABELS[tries] ?? "…";
          return;
        }
        // Last line: actually "quit". Power off, sit in the dark, come back.
        say(text);
        yes.disabled = true;
        later(() => {
          dialog.close();
          yes.disabled = false;
          shutdownDone = true;
          quitHint.textContent = "Don't.";
          offText.textContent = "";
          root.classList.add("is-off");
          later(() => (offText.textContent = "Quit failed."), reduce ? 200 : 1500);
          later(() => (offText.textContent = "Nobody quits here. Returning to main menu…"), reduce ? 1200 : 2900);
          // …and it starts up again, the whole way: the boot screen, the
          // jingle, "Press start". (Press start brings the menu back.)
          later(() => {
            root.classList.remove("is-off");
            select(0);
            playBoot();
            unlock("nobody-quits");
          }, reduce ? 2400 : 4800);
        }, 900);
      },
      { signal }
    );

    // ── Tips ─────────────────────────────────────────────────────
    const tipEl = root.querySelector<HTMLElement>("[data-tip]")!;
    const tips: string[] = JSON.parse(tipEl.dataset.tips || "[]");
    const tipBox = tipEl.closest<HTMLElement>(".tip")!;
    // {other} becomes the other time of day from the current scene.
    const tipText = (tip: string) =>
      tip.replace("{other}", html.dataset.scene === "day" ? "after dark" : "in daylight");
    let t = 0;
    const timer = window.setInterval(() => {
      if (document.hidden || tips.length < 2) return;
      t = (t + 1) % tips.length;
      if (reduce) {
        tipEl.textContent = tipText(tips[t]);
        return;
      }
      tipBox.classList.add("is-out");
      window.setTimeout(() => {
        tipEl.textContent = tipText(tips[t]);
        tipBox.classList.remove("is-out");
      }, 500);
    }, 6000);

    cleanup = (to?: string) => {
      ac.abort();
      window.clearTimeout(aimTimer);
      html.classList.remove("ambient");
      if (document.fullscreenElement) document.exitFullscreen().catch(() => {});
      if (!to || !music.isMenuPath(to)) music.stop();
      stopBootSound();
      window.clearInterval(timer);
      timers.forEach(window.clearTimeout);
      if (dialog.open) dialog.close();
      delete html.dataset.boot;
    };
  }

  document.addEventListener("astro:page-load", initTitle);
  document.addEventListener("astro:before-swap", e => {
    cleanup?.(e.to?.pathname);
    cleanup = null;
  });
</script>

