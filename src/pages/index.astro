  /* ── Quit dialog ─────────────────────────────────────────────── */
  .quit {
    width: min(26rem, calc(100vw - 2.5rem));
    margin: auto;
    padding: 1.6rem 1.6rem 1.4rem;
    border: 2px solid rgb(154 160 214 / 0.35);
