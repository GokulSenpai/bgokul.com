---
import { getCollection } from "astro:content";
import type { GetStaticPathsOptions } from "astro";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Notebook from "@/components/journal/Notebook.astro";
import JournalEntry from "@/components/journal/JournalEntry.astro";
import Pagination from "@/components/Pagination.astro";
import { getUniqueTags } from "@/utils/getUniqueTags";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { slugifyAll } from "@/utils/slugify";
import config from "@/config";

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const posts = await getCollection("posts", ({ data }) => !data.draft);
  const tags = getUniqueTags(posts);

  return tags.flatMap(({ tag, tagName }) => {
    const tagPosts = getSortedPosts(posts.filter(({ data }) => slugifyAll(data.tags).includes(tag)));
    return paginate(tagPosts, {
      params: { tag },
      props: { tagName },
      pageSize: config.posts.perPage,
    });
  });
}

const { page, tagName } = Astro.props;
---

<Layout title={`#${tagName} | ${config.site.title}`}>
  <Header />

  <Notebook
    title={`#${tagName}`}
    kicker={`${page.total} ${page.total === 1 ? "entry" : "entries"} tagged`}
  >
    <ul class="nb-entries">
      {page.data.map(p => <JournalEntry post={p} />)}
    </ul>
    <Pagination {page} />
    <div class="nb-links">
      <a class="nb-btn" href="/tags/">All tags</a>
    </div>
  </Notebook>

  <Footer />
</Layout>
