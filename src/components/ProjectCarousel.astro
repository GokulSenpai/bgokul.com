---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  images: ImageMetadata[];
}

const { images } = Astro.props;
---

{
  images.length > 0 && (
    <div class="carousel" data-carousel>
      <div class="carousel-track" data-carousel-track tabindex="0" aria-label="Image gallery, use arrow keys or the buttons below to navigate">
        {images.length > 1 && (
          <div class="carousel-slide" data-carousel-slide data-carousel-clone aria-hidden="true">
            <Image
              src={images[images.length - 1]}
              alt=""
              width={1600}
              height={900}
              loading="eager"
              draggable="false"
              class="border-border aspect-video w-full rounded border object-cover"
            />
          </div>
        )}
        {images.map((img, i) => (
          <div class="carousel-slide" data-carousel-slide>
            <Image
              src={img}
              alt=""
              width={1600}
              height={900}
              loading={i === 0 ? "eager" : "lazy"}
              fetchpriority={i === 0 ? "high" : undefined}
              draggable="false"
              class="border-border aspect-video w-full rounded border object-cover"
            />
          </div>
        ))}
        {images.length > 1 && (
          <div class="carousel-slide" data-carousel-slide data-carousel-clone aria-hidden="true">
            {/* Eager, not lazy: this copy sits at the far end of the strip,
                 so a lazy image would only start loading as the last-to-first
                 wrap slides it into view, showing an empty frame mid-glide.
                 Same file as the first image, so it comes from the cache. */}
            <Image
              src={images[0]}
              alt=""
              width={1600}
              height={900}
              loading="eager"
              draggable="false"
              class="border-border aspect-video w-full rounded border object-cover"
            />
          </div>
        )}
      </div>
      {images.length > 1 && (
        <>
          <button
            type="button"
            class="carousel-arrow carousel-arrow-prev"
            data-carousel-prev
            aria-label="Previous image"
          >
            ‹
          </button>
          <button
            type="button"
            class="carousel-arrow carousel-arrow-next"
            data-carousel-next
            aria-label="Next image"
          >
            ›
          </button>
          <div class="carousel-dots" role="tablist" aria-label="Slides">
            {images.map((_, i) => (
              <button
                type="button"
                class="carousel-dot"
                data-carousel-dot={i}
                aria-label={`Go to image ${i + 1}`}
              />
            ))}
          </div>
        </>
      )}
    </div>
  )
}

<script>
  function initCarousels() {
    document.querySelectorAll<HTMLElement>("[data-carousel]").forEach(carousel => {
      if (carousel.dataset.carouselInit) return;
      carousel.dataset.carouselInit = "true";

      const track = carousel.querySelector<HTMLElement>("[data-carousel-track]");
      // `slides` is every slide in the DOM, including the leading/trailing
      // clones used to fake an infinite loop. `realCount` excludes those —
      // real slide `i` always lives at `slides[i + loop]` (loop = 1 when
      // clones exist, 0 otherwise).
      const slides = Array.from(
        carousel.querySelectorAll<HTMLElement>("[data-carousel-slide]")
      );
      const loop = carousel.querySelector("[data-carousel-clone]") ? 1 : 0;
      const realCount = slides.length - loop * 2;
      const prevBtn = carousel.querySelector<HTMLButtonElement>("[data-carousel-prev]");
      const nextBtn = carousel.querySelector<HTMLButtonElement>("[data-carousel-next]");
      const dots = Array.from(
        carousel.querySelectorAll<HTMLButtonElement>("[data-carousel-dot]")
      );
      if (!track || realCount === 0) return;

      const prefersReducedMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)"
      ).matches;

      let index = 0;
      let autoplayTimer: ReturnType<typeof setInterval> | null = null;

      function updateDots() {
        dots.forEach((dot, di) => dot.classList.toggle("is-active", di === index));
      }

      // CSS's default `ease` timing function (cubic-bezier(0.25, 0.1, 0.25, 1))
      // — matches how Swiper.js transitions between slides, which is the
      // reference feel this carousel's snap timing is now matched to.
      function cssEase(x: number): number {
        const p1x = 0.25,
          p1y = 0.1,
          p2x = 0.25,
          p2y = 1;
        const A = (a1: number, a2: number) => 1 - 3 * a2 + 3 * a1;
        const B = (a1: number, a2: number) => 3 * a2 - 6 * a1;
        const C = (a1: number) => 3 * a1;
        const calcBezier = (t: number, a1: number, a2: number) =>
          ((A(a1, a2) * t + B(a1, a2)) * t + C(a1)) * t;
        const calcSlope = (t: number, a1: number, a2: number) =>
          3 * A(a1, a2) * t * t + 2 * B(a1, a2) * t + C(a1);
        let t = x;
        for (let i = 0; i < 6; i++) {
          const xEst = calcBezier(t, p1x, p2x) - x;
          if (Math.abs(xEst) < 1e-6) break;
          const slope = calcSlope(t, p1x, p2x);
          if (Math.abs(slope) < 1e-6) break;
          t -= xEst / slope;
        }
        return calcBezier(t, p1y, p2y);
      }

      // A hand-rolled tween instead of `scrollTo({ behavior: "smooth" })` —
      // the native smooth-scroll can behave subtly differently right at the
      // end of the scrollable area (easing/duration can shift near a
      // boundary in some browsers), which made the last-slide-to-first wrap
      // feel like a different motion than every other transition. Animating
      // scrollLeft by hand keeps every transition, wrap included, identical.
      let scrollAnimFrame: number | null = null;
      function animateScrollTo(target: number, instant = false) {
        if (scrollAnimFrame !== null) cancelAnimationFrame(scrollAnimFrame);
        const start = track!.scrollLeft;
        const change = target - start;
        if (instant || prefersReducedMotion || change === 0) {
          track!.scrollLeft = target;
          // Covers releasing a drag with zero distance left to travel —
          // is-dragging was set at drag-start, and the animated branch below
          // is the only other place that clears it.
          track!.classList.remove("is-dragging");
          return;
        }
        const duration = 300; // matches Swiper.js's default `speed`
        const startTime = performance.now();
        track!.classList.add("is-dragging"); // also disables scroll-snap mid-animation
        function step(now: number) {
          const t = Math.min((now - startTime) / duration, 1);
          track!.scrollLeft = start + change * cssEase(t);
          if (t < 1) {
            scrollAnimFrame = requestAnimationFrame(step);
          } else {
            scrollAnimFrame = null;
            track!.classList.remove("is-dragging");
          }
        }
        scrollAnimFrame = requestAnimationFrame(step);
      }

      function goTo(i: number, instant = false) {
        index = (i + realCount) % realCount;
        animateScrollTo(slides[index + loop].offsetLeft, instant);
        updateDots();
      }

      // Same tween as animateScrollTo, but eases toward the clone's position
      // while the *last* frame lands on the real slide instead — one single,
      // uninterrupted rAF loop with no separate "instant hop" step and no
      // synchronous scrollLeft read-back between two calls. That two-step
      // version depended on the browser having already committed the hop by
      // the time the second call re-read `track.scrollLeft`, which is not
      // guaranteed while scroll-snap is still active — this doesn't have
      // that dependency at all.
      function animateWrap(cloneTarget: number, realTarget: number) {
        if (scrollAnimFrame !== null) cancelAnimationFrame(scrollAnimFrame);
        const start = track!.scrollLeft;
        const change = cloneTarget - start;
        if (prefersReducedMotion || change === 0) {
          track!.scrollLeft = realTarget;
          return;
        }
        const duration = 300;
        const startTime = performance.now();
        track!.classList.add("is-dragging");
        function step(now: number) {
          const t = Math.min((now - startTime) / duration, 1);
          if (t < 1) {
            track!.scrollLeft = start + change * cssEase(t);
            scrollAnimFrame = requestAnimationFrame(step);
          } else {
            track!.scrollLeft = realTarget;
            scrollAnimFrame = null;
            track!.classList.remove("is-dragging");
          }
        }
        scrollAnimFrame = requestAnimationFrame(step);
      }

      // True while the user has an active touch or trackpad/wheel gesture on
      // the track. Native scroll-snap can settle onto the nearest slide once
      // a drag crosses the halfway point, well before the gesture actually
      // ends — harmless everywhere else, but if that "settle" happens to
      // land on a clone it looks like a finished scroll to reparkIfOnClone
      // below, which then repositions the track mid-gesture, fighting the
      // user's own scroll. Skip reparking until the gesture is over.
      //
      // Touch has real start/end events. Trackpad/mouse-wheel doesn't — it's
      // a stream of discrete `wheel` events with no signal for when the
      // gesture stops, so that's tracked with a short idle timeout instead.
      let isTouching = false;
      track.addEventListener("touchstart", () => (isTouching = true), { passive: true });
      track.addEventListener(
        "touchend",
        () => {
          isTouching = false;
          reparkIfOnClone();
        },
        { passive: true }
      );
      track.addEventListener("touchcancel", () => (isTouching = false), { passive: true });

      let isWheeling = false;
      let wheelIdleTimer: ReturnType<typeof setTimeout> | null = null;
      track.addEventListener(
        "wheel",
        () => {
          isWheeling = true;
          if (wheelIdleTimer) clearTimeout(wheelIdleTimer);
          wheelIdleTimer = setTimeout(() => {
            isWheeling = false;
            reparkIfOnClone();
          }, 200);
        },
        { passive: true }
      );

      // Once a scroll (ours or the user's) actually finishes on a clone,
      // silently re-park on the matching real slide with no animation — the
      // clone makes it look like the track just kept going past the end.
      // This has to wait for the scroll to be genuinely done: firing mid-
      // animation (e.g. off a fixed-delay debounce) cuts the smooth scroll
      // short and shows up as a visible snap-back instead of a seamless loop.
      function reparkIfOnClone() {
        if (!loop || isTouching || isDragging || isWheeling) return;
        const nearest = slides.reduce((best, slide, i) => {
          const dist = Math.abs(slide.offsetLeft - track!.scrollLeft);
          return dist < Math.abs(slides[best].offsetLeft - track!.scrollLeft)
            ? i
            : best;
        }, 0);
        if (nearest === 0) {
          index = realCount - 1;
          animateScrollTo(slides[realCount].offsetLeft, true);
          updateDots();
        } else if (nearest === slides.length - 1) {
          index = 0;
          animateScrollTo(slides[loop].offsetLeft, true);
          updateDots();
        }
      }

      if ("onscrollend" in window) {
        track.addEventListener("scrollend", reparkIfOnClone);
      } else {
        // Fallback for browsers without `scrollend` (older Safari): debounce
        // on a longer delay than a typical smooth-scroll animation takes, so
        // it only fires once movement has actually stopped.
        let settleTimer: ReturnType<typeof setTimeout> | null = null;
        track.addEventListener(
          "scroll",
          () => {
            if (settleTimer) clearTimeout(settleTimer);
            settleTimer = setTimeout(reparkIfOnClone, 400);
          },
          { passive: true }
        );
      }

      function next() {
        if (loop && index === realCount - 1) {
          index = 0;
          animateWrap(slides[slides.length - 1].offsetLeft, slides[loop].offsetLeft);
          updateDots();
        } else {
          goTo(index + 1);
        }
      }

      function prev() {
        if (loop && index === 0) {
          index = realCount - 1;
          animateWrap(slides[0].offsetLeft, slides[realCount].offsetLeft);
          updateDots();
        } else {
          goTo(index - 1);
        }
      }

      function startAutoplay() {
        if (prefersReducedMotion || realCount < 2) return;
        stopAutoplay();
        autoplayTimer = setInterval(next, 2800);
        scheduleArrowsAutoHide();
      }

      function stopAutoplay() {
        if (autoplayTimer) clearInterval(autoplayTimer);
        autoplayTimer = null;
      }

      // Clicking an arrow gives it keyboard focus, and `:focus-within` (not
      // just `:hover`) is what CSS uses to keep the arrows visible — so
      // without this, focus staying on the button after a click was the only
      // reason they'd stay stuck visible until you clicked elsewhere to blur
      // it. This forces them to fade out a few seconds after autoplay
      // (re)starts, overriding that stuck-focus state regardless of hover.
      let arrowHideTimer: ReturnType<typeof setTimeout> | null = null;
      function scheduleArrowsAutoHide() {
        if (arrowHideTimer) clearTimeout(arrowHideTimer);
        carousel.classList.remove("arrows-force-hidden");
        arrowHideTimer = setTimeout(() => {
          carousel.classList.add("arrows-force-hidden");
        }, 2500);
      }

      prevBtn?.addEventListener("click", () => {
        prev();
        startAutoplay();
      });
      nextBtn?.addEventListener("click", () => {
        next();
        startAutoplay();
      });
      dots.forEach((dot, di) => {
        dot.addEventListener("click", () => {
          goTo(di);
          startAutoplay();
        });
      });

      // Mouse-drag swipe support (touch already scrolls natively).
      let isDragging = false;
      let dragStartX = 0;
      let dragStartScroll = 0;
      let dragSettleTimer: ReturnType<typeof setTimeout> | null = null;

      track.addEventListener("pointerdown", e => {
        if (e.pointerType === "touch") return;
        // Stop native image-drag / text-selection from hijacking the
        // gesture before our own pointermove handler gets a chance.
        e.preventDefault();
        // A pending re-enable from a *previous* drag (see endDrag below)
        // could otherwise fire mid-way through this new one — cancel it so
        // scroll-snap only ever comes back after the most recent drag has
        // actually settled.
        if (dragSettleTimer) {
          clearTimeout(dragSettleTimer);
          dragSettleTimer = null;
        }
        isDragging = true;
        dragStartX = e.clientX;
        dragStartScroll = track.scrollLeft;
        track.setPointerCapture(e.pointerId);
        // Scroll-snap fights a manually-driven scrollLeft mid-drag,
        // making the track jump straight to the next slide instead of
        // following the pointer. Turn it off for the duration of the drag.
        track.classList.add("is-dragging");
        stopAutoplay();
      });

      track.addEventListener("pointermove", e => {
        if (!isDragging) return;
        track.scrollLeft = dragStartScroll - (e.clientX - dragStartX);
      });

      function endDrag() {
        if (!isDragging) return;
        isDragging = false;
        const nearest = slides.reduce((best, slide, i) => {
          const dist = Math.abs(slide.offsetLeft - track!.scrollLeft);
          return dist < Math.abs(slides[best].offsetLeft - track!.scrollLeft)
            ? i
            : best;
        }, 0);
        if (loop && (nearest === 0 || nearest === slides.length - 1)) {
          // Released close to a loop clone — glide the short remaining
          // distance onto the clone itself (the same short hop any other
          // release does), not straight to the real slide it stands in for,
          // which can sit almost the full width of the track away and would
          // cover that distance in the same fixed duration, looking like a
          // near-instant snap instead of a glide. reparkIfOnClone silently
          // lands on the matching real slide once this settles.
          index = nearest === 0 ? realCount - 1 : 0;
          animateScrollTo(slides[nearest].offsetLeft);
          updateDots();
        } else {
          goTo(nearest - loop);
        }
        startAutoplay();
        // Keep scroll-snap off until the smooth scroll above has actually
        // settled. Re-enabling it immediately lets the browser's own CSS
        // snap-correction race the JS animation and win, which looks like
        // an instant snap-back instead of the smooth glide `goTo` does
        // everywhere else (autoplay, buttons, dots).
        if (dragSettleTimer) clearTimeout(dragSettleTimer);
        dragSettleTimer = setTimeout(() => {
          track!.classList.remove("is-dragging");
          dragSettleTimer = null;
        }, 500);
      }

      track.addEventListener("pointerup", endDrag);
      track.addEventListener("pointercancel", endDrag);
      track.addEventListener("pointerleave", () => {
        if (isDragging) endDrag();
      });

      track.addEventListener("keydown", e => {
        if (e.key === "ArrowRight") {
          next();
          startAutoplay();
        } else if (e.key === "ArrowLeft") {
          prev();
          startAutoplay();
        }
      });

      carousel.addEventListener("mouseenter", () => {
        stopAutoplay();
        if (arrowHideTimer) clearTimeout(arrowHideTimer);
        carousel.classList.remove("arrows-force-hidden");
      });
      // Keeps resetting the auto-hide countdown while the mouse is actually
      // moving over the carousel — without this, a stationary hover (reading
      // an image before deciding whether to click) could let the arrows
      // auto-hide mid-browse. Since `pointer-events: none` comes with that
      // hidden state, and a still mouse never re-fires `mouseenter`, the next
      // click on a now-invisible arrow would silently do nothing.
      carousel.addEventListener("mousemove", () => {
        if (!carousel.matches(":hover")) return;
        if (arrowHideTimer) clearTimeout(arrowHideTimer);
        carousel.classList.remove("arrows-force-hidden");
        arrowHideTimer = setTimeout(() => {
          carousel.classList.add("arrows-force-hidden");
        }, 2500);
      });
      carousel.addEventListener("mouseleave", startAutoplay);

      goTo(0, true);
      startAutoplay();
    });
  }

  initCarousels();
  document.addEventListener("astro:page-load", initCarousels);
</script>

<style>
  .carousel {
    position: relative;
  }

  .carousel-track {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    cursor: grab;
    border-radius: var(--radius, 0.5rem);
    user-select: none;
    -webkit-user-select: none;
    touch-action: pan-y;
  }

  /* Disabled during an active mouse-drag so the track follows the pointer
     1:1 instead of the browser snapping it straight to the next slide. */
  .carousel-track.is-dragging {
    scroll-snap-type: none;
  }

  .carousel-track:active {
    cursor: grabbing;
  }

  .carousel-track::-webkit-scrollbar {
    display: none;
  }

  .carousel-slide {
    flex: 0 0 100%;
    scroll-snap-align: start;
  }

  .carousel-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 999px;
    border: none;
    background: transparent;
    color: #fff;
    font-size: 1.75rem;
    line-height: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.7);
    transition:
      transform 0.15s ease,
      opacity 0.15s ease;
    /* Hidden until the pointer is over the carousel — autoplay just does
       its own thing otherwise. Always shown on touch devices, which have
       no hover state to reveal them. */
    opacity: 0;
    pointer-events: none;
  }

  .carousel:hover .carousel-arrow,
  .carousel:focus-within .carousel-arrow {
    opacity: 0.75;
    pointer-events: auto;
  }

  .carousel-arrow:hover {
    opacity: 1;
    transform: translateY(-50%) scale(1.15);
  }

  @media (hover: none) {
    .carousel-arrow {
      opacity: 0.75;
      pointer-events: auto;
    }
  }

  /* Forces the arrows to fade out a few seconds after autoplay (re)starts —
     see scheduleArrowsAutoHide in the script. Higher specificity than the
     hover/focus-within/touch rules above so it always wins while active,
     regardless of whether the mouse or focus is still technically "on" the
     carousel. */
  .carousel.arrows-force-hidden .carousel-arrow {
    opacity: 0;
    pointer-events: none;
  }

  .carousel-arrow-prev {
    left: 0.5rem;
  }

  .carousel-arrow-next {
    right: 0.5rem;
  }

  .carousel-dots {
    display: flex;
    justify-content: center;
    gap: 0.4rem;
    margin-top: 0.6rem;
  }

  .carousel-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 999px;
    border: none;
    background: var(--muted);
    cursor: pointer;
  }

  .carousel-dot.is-active {
    background: var(--accent);
  }
</style>
