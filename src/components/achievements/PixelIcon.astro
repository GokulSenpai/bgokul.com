---
/**
 * A tiny pixel icon (8x8), drawn from a grid of "#" (ink) and "." (empty),
 * crisp at any size. Colour is currentColor.
 */
interface Props {
  name: string;
  class?: string;
}

const ICONS: Record<string, string[]> = {
  scroll: [".######.", "#......#", ".#.##.#.", ".#....#.", ".#.##.#.", ".#....#.", "#......#", ".######."],
  card: ["........", "########", "#......#", "#.##...#", "#......#", "#.####.#", "########", "........"],
  mail: ["........", "########", "##....##", "#.#..#.#", "#..##..#", "#......#", "########", "........"],
  door: [".######.", ".#....#.", ".#....#.", ".#..#.#.", ".#....#.", ".#....#.", ".#....#.", "########"],
  power: ["...##...", ".#.##.#.", "#..##..#", "#......#", "#......#", "#......#", ".#....#.", "..####.."],
  wave: ["#.#.#...", "#.#.#...", "#####...", "#####.#.", "######..", "#####...", ".###....", ".###...."],
  ripple: ["........", "..####..", ".#....#.", "#..##..#", ".#....#.", "..####..", "........", "........"],
  star: ["...#....", "...#....", "#######.", ".#####..", "..###...", ".##.##..", ".#...#..", "........"],
  dolphin: ["....#...", "...###..", ".######.", "##.#####", "#....###", "......##", ".......#", "........"],
  moon: ["..###...", ".##.....", "##......", "##......", "##......", ".##.....", "..###...", "........"],
  wave2: ["........", "........", ".##..##.", "#..##..#", "........", ".##..##.", "#..##..#", "........"],
  rewind: ["........", "..#..#..", ".##.##..", "###.###.", ".##.##..", "..#..#..", "........", "........"],
  cart: ["########", "#......#", "#.####.#", "#.####.#", "#......#", "########", ".######.", ".#.#.#.."],
  gamepad: ["........", ".######.", "##.###.#", "#...#.##", "##.###.#", "########", "##....##", "........"],
  pencil: [".......#", "......##", ".....##.", "....##..", "...##...", "..##....", ".#.#....", "##......"],
  book: ["##....##", "#.#..#.#", "#..##..#", "#..##..#", "#..##..#", "#..##..#", "#.####.#", "##....##"],
  screw: ["..####..", ".#.##.#.", ".######.", "..####..", "..#..#..", "...##...", "..#..#..", "...##..."],
  page: [".#####..", ".#...##.", ".#....#.", ".#.##.#.", ".#....#.", ".#.##.#.", ".#....#.", ".######."],
  note: ["...####.", "...#..#.", "...#..#.", "...#..#.", ".###.##.", "####.###", ".##...#.", "........"],
  key: [".###....", "#...#...", "#...#...", ".####...", "....#...", "....##..", "....#...", "....##.."],
  paint: ["..###...", ".#####..", "#######.", "########", ".######.", "..####.#", ".......#", "......##"],
  exit: ["#####...", "#...#...", "#...#.#.", "#...##..", "#...####", "#...##..", "#...#.#.", "#####..."],
  bird: ["........", "........", "##....##", ".##..##.", "..####..", "...##...", "........", "........"],
  sound: ["...#....", "..##..#.", "####.#.#", "####.#.#", "####.#.#", "..##..#.", "...#....", "........"],
  mute: ["...#....", "..##....", "####.#.#", "####..#.", "####.#.#", "..##....", "...#....", "........"],
  link: ["........", ".###....", "#...#...", "#..#.##.", ".##.#..#", "...#...#", "....###.", "........"],
  share: ["......##", "......##", "....##..", "##.#....", "##.#....", "....##..", "......##", "......##"],
  lock: ["..####..", ".#....#.", ".#....#.", "########", "###..###", "###..###", "########", "........"],
  trophy: ["########", "#.####.#", "#.####.#", ".######.", "..####..", "...##...", "..####..", ".######."],
};

const { name, class: cls } = Astro.props;
const grid = ICONS[name] ?? ICONS.lock;
const cells = grid.flatMap((row, y) => [...row].map((c, x) => (c === "#" ? { x, y } : null)).filter(Boolean)) as {
  x: number;
  y: number;
}[];
---

<svg class={cls} viewBox="0 0 8 8" shape-rendering="crispEdges" aria-hidden="true">
  <g fill="currentColor">
    {cells.map(c => <rect x={c.x} y={c.y} width="1" height="1" />)}
  </g>
</svg>
