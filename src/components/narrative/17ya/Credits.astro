---
/**
 * The game's four credit screens, one after another on a black card. The
 * fade-ins start when the card first renders, which is when the ending is
 * opened (content in a closed <details> isn't rendered).
 */
---

<figure class="credits">
  <p class="c c1 big">312 hours awake.</p>
  <p class="c c2 name">— ANGELO —<span>19XX–19XX</span></p>
  <p class="c c3">He asked the world to be kind to you.</p>
  <p class="c c4 last">Goodnight, Ilya.</p>
</figure>

<style>
  .credits {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2.25rem;
    margin: 2.5rem 0;
    padding: 3.5rem 1.5rem;
    background: #000;
    border: 1px solid rgb(200 188 168 / 0.1);
    text-align: center;
  }
  .c {
    margin: 0 !important;
    text-indent: 0 !important;
    font-family: var(--nv-display);
    color: #f0ead8;
    animation: credit-in 1.6s ease both;
  }
  .c1 {
    animation-delay: 0.6s;
  }
  .c2 {
    animation-delay: 2s;
  }
  .c3 {
    animation-delay: 3.6s;
  }
  .c4 {
    animation-delay: 5.4s;
  }
  @keyframes credit-in {
    from {
      opacity: 0;
    }
  }
  .big {
    font-size: clamp(1.8rem, 6vw, 2.6rem);
    font-weight: 600;
    line-height: 1.1;
  }
  .name {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    font-size: 1.3em;
    font-weight: 600;
    letter-spacing: 0.2em;
  }
  .name span {
    font-family: var(--font-google-sans-code), ui-monospace, monospace;
    font-size: 0.55em;
    font-weight: 400;
    letter-spacing: 0.15em;
    color: var(--nv-muted);
  }
  .c3 {
    font-size: 1.2em;
    font-style: italic;
  }
  .last {
    font-size: 1.5em;
    font-weight: 600;
  }
  @media (prefers-reduced-motion: reduce) {
    .c {
      animation: none;
    }
  }
</style>
