---
/**
 * One of 17YA's white line drawings (from the game's overlay art), shown
 * like chalk on the dark page.
 */
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  size?: "sm" | "md" | "lg";
}

const { src, alt, caption, size = "md" } = Astro.props;
---

<figure class:list={["sketch", size]}>
  <Image src={src} alt={alt} widths={[320, 520, 900]} sizes="(min-width: 700px) 520px, 90vw" loading="lazy" />
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .sketch {
    margin: 2.5rem auto;
    text-align: center;
  }
  .sketch.sm {
    max-width: 15rem;
  }
  .sketch.md {
    max-width: 24rem;
  }
  .sketch.lg {
    max-width: 34rem;
  }
  .sketch :global(img) {
    display: block;
    width: 100%;
    height: auto;
    opacity: 0.82;
    filter: drop-shadow(0 0 6px rgb(236 230 214 / 0.08));
  }
  figcaption {
    margin-top: 0.6rem;
    font-size: 0.8em;
    font-style: italic;
    color: var(--nv-muted);
  }
</style>
