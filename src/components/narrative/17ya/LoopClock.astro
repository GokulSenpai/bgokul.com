---
/**
 * The room's wall clock, barely visible behind the page. Scrolling winds
 * the minute hand anticlockwise from II back to XII (the hour hand rewinds
 * with it), so the page ends at twelve, the start of the loop again.
 */
// Only the stretch the hand travels is numbered (XII, I, II), like the
// game's clock. The other hours are just their tick marks.
const numerals = ["XII", "I", "II"];
const ticks = Array.from({ length: 60 }, (_, i) => i);
---

<div class="wall-clock" aria-hidden="true" data-wall-clock>
  <svg viewBox="-100 -100 200 200">
    <circle r="96" class="rim" />
    <circle r="91" class="rim-inner" />
    {
      ticks.map(i => (
        <line
          y1={i % 5 === 0 ? -88 : -89}
          y2={i % 5 === 0 ? -82 : -86}
          transform={`rotate(${i * 6})`}
          class:list={["tick", { major: i % 5 === 0 }]}
        />
      ))
    }
    {
      numerals.map((n, i) => {
        const a = (i * 30 * Math.PI) / 180;
        return (
          <text x={Math.sin(a) * 70} y={-Math.cos(a) * 70} class="num">
            {n}
          </text>
        );
      })
    }
    <g data-hour-hand class="hand-g" style="transform: rotate(5deg)">
      <path d="M -3 8 L -1.6 -44 L 0 -48 L 1.6 -44 L 3 8 Z" class="hand" />
    </g>
    <g data-minute-hand class="hand-g" style="transform: rotate(60deg)">
      <path d="M -2 10 L -1 -70 L 0 -74 L 1 -70 L 2 10 Z" class="hand" />
    </g>
    <circle r="4" class="hub" />
    <!-- Cracked glass, drawn in when the trigger is pulled. -->
    <g class="cracks">
      <path pathLength="1" d="M 28 -22 L 41 -52 L 47 -71 L 55 -90" />
      <path pathLength="1" d="M 28 -22 L 58 -31 L 77 -27 L 93 -33" />
      <path pathLength="1" d="M 28 -22 L 49 4 L 63 31 L 76 54" />
      <path pathLength="1" d="M 28 -22 L 22 9 L 15 38 L 9 66 L 4 91" />
      <path pathLength="1" d="M 28 -22 L 2 -12 L -27 -2 L -61 6 L -88 13" />
      <path pathLength="1" d="M 28 -22 L 12 -47 L 1 -70 L -9 -93" />
      <path pathLength="1" d="M 41 -52 L 60 -58 M 49 4 L 30 18 M -27 -2 L -36 -25 M 15 38 L 33 52" />
      <path pathLength="1" d="M 21 -29 L 36 -30 L 37 -15 L 24 -12 Z" />
    </g>
  </svg>
</div>

<script>
  // Runs backwards, like a loop rewinding: the minute hand turns
  // anticlockwise from II (10 past, 60 deg) back to XII (0 deg), and the
  // hour hand rewinds from 12:10 to exactly 12:00, so both meet at twelve.
  const MIN_FROM = 60;
  const MIN_TO = 0;

  function initWallClock() {
    const root = document.querySelector<HTMLElement>("[data-wall-clock]");
    if (!root || root.dataset.init) return;
    root.dataset.init = "true";
    const minute = root.querySelector<SVGGElement>("[data-minute-hand]")!;
    const hour = root.querySelector<SVGGElement>("[data-hour-hand]")!;
    let frame = 0;
    let broken = false;
    const update = () => {
      frame = 0;
      if (broken) return;
      const max = document.documentElement.scrollHeight - innerHeight;
      const t = max > 0 ? Math.min(1, Math.max(0, scrollY / max)) : 0;
      const m = MIN_FROM + (MIN_TO - MIN_FROM) * t; // degrees
      const minutes = m / 6; // 10 -> 0
      minute.style.transform = `rotate(${m}deg)`;
      hour.style.transform = `rotate(${minutes / 2}deg)`;
    };

    // "Pull the trigger." breaks the clock: the glass cracks, the clock
    // knocks crooked, and both hands come loose and swing down to hang.
    // Time stops following the page after that.
    const breakClock = () => {
      if (broken) return;
      broken = true;
      root.classList.add("is-broken");
      minute.style.transform = "rotate(172deg)";
      hour.style.transform = "rotate(196deg)";
    };
    const onScroll = () => {
      if (!frame) frame = requestAnimationFrame(update);
    };
    const ctl = new AbortController();
    addEventListener("scroll", onScroll, { passive: true, signal: ctl.signal });
    addEventListener("resize", onScroll, { passive: true, signal: ctl.signal });
    document.addEventListener("17ya:trigger", breakClock, { signal: ctl.signal });
    document.addEventListener("astro:before-swap", () => ctl.abort(), { once: true });
    update();
  }
  initWallClock();
  document.addEventListener("astro:page-load", initWallClock);
</script>

<style>
  /* Fixed behind the text (the chapter is its own stacking context). */
  .wall-clock {
    position: fixed;
    top: 50%;
    left: 50%;
    z-index: -1;
    width: min(92vmin, 820px);
    aspect-ratio: 1;
    transform: translate(-50%, -50%);
    pointer-events: none;
    opacity: 0.055;
  }
  svg {
    display: block;
    width: 100%;
    height: 100%;
    color: var(--nv-ink);
  }
  .rim {
    fill: none;
    stroke: currentColor;
    stroke-width: 3;
  }
  .rim-inner {
    fill: none;
    stroke: currentColor;
    stroke-width: 0.6;
  }
  .tick {
    stroke: currentColor;
    stroke-width: 0.6;
  }
  .tick.major {
    stroke-width: 1.4;
  }
  .num {
    fill: currentColor;
    font-family: var(--nv-display);
    font-size: 12px;
    font-weight: 600;
    text-anchor: middle;
    dominant-baseline: central;
  }
  .hand,
  .hub {
    fill: currentColor;
  }
  .hand-g {
    transform-box: view-box;
    transform-origin: 0 0;
  }

  /* ── broken ─────────────────────────────────────────────── */
  .wall-clock {
    transition: opacity 1.2s ease, transform 0.25s cubic-bezier(0.3, 1.8, 0.5, 1);
  }
  .wall-clock.is-broken {
    opacity: 0.11;
    transform: translate(-50%, -50%) rotate(-6deg);
  }
  .is-broken .hand-g {
    /* Loose hands overshoot as they drop, then settle. */
    transition: transform 1.8s cubic-bezier(0.45, -0.25, 0.3, 1.45);
  }
  .is-broken [data-hour-hand] {
    transition-delay: 0.2s;
  }
  .cracks path {
    fill: none;
    stroke: currentColor;
    stroke-width: 0.8;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }
  .is-broken .cracks path {
    stroke-dashoffset: 0;
    transition: stroke-dashoffset 0.5s ease-out;
  }
  @media (prefers-reduced-motion: reduce) {
    .wall-clock,
    .is-broken .hand-g,
    .is-broken .cracks path {
      transition: none;
    }
  }
</style>
