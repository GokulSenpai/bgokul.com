---
/**
 * A stretch of the room's wall with Angelo's thoughts chalked onto it.
 * Each line sits at x/y (percent) with a slight rotation. Brighter lines are
 * progressor words, the ones the player drags into the letter. On phones the
 * wall becomes a loose stack so nothing overlaps.
 */
interface Line {
  text: string;
  x: number;
  y: number;
  rot?: number;
  size?: number; // relative, 1 = normal
  bright?: boolean;
  near?: string; // the object it was written beside
}

interface Props {
  lines: Line[];
  caption?: string;
}

const { lines, caption } = Astro.props;
---

<figure class="wall">
  <div class="wall-surface">
    {
      lines.map(l => (
        <p
          class:list={["chalk", { bright: l.bright }]}
          style={`--x:${l.x}%;--y:${l.y}%;--r:${l.rot ?? 0}deg;--s:${l.size ?? 1}`}
        >
          {l.text}
          {l.near && <span class="near">{l.near}</span>}
        </p>
      ))
    }
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  /* Wider than the reading column, centred on it. */
  .wall {
    --w: min(calc(100vw - 2.5rem), 56rem);
    width: var(--w);
    margin: 2.5rem calc((100% - var(--w)) / 2);
  }
  .wall-surface {
    position: relative;
    padding: 1.5rem 1.25rem;
    border: 1px solid rgb(200 188 168 / 0.12);
    background:
      radial-gradient(ellipse at 30% 20%, rgb(255 255 255 / 0.04), transparent 60%),
      repeating-linear-gradient(0deg, rgb(255 255 255 / 0.012) 0 2px, transparent 2px 5px),
      #1b1918;
  }
  .chalk {
    margin: 0 0 0.9rem;
    transform: rotate(var(--r));
    font-family: var(--nv-body);
    font-style: italic;
    font-size: calc(1.05em * var(--s));
    line-height: 1.2;
    text-indent: 0 !important;
    color: rgb(236 230 214 / 0.72);
    text-shadow:
      0 0 1px rgb(236 230 214 / 0.5),
      0 0 6px rgb(236 230 214 / 0.08);
    filter: blur(0.15px);
  }
  .chalk.bright {
    color: #f6efd9;
    font-style: normal;
    font-family: var(--nv-display);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-shadow:
      0 0 1px rgb(255 248 230 / 0.8),
      0 0 14px rgb(200 148 58 / 0.35);
  }
  .near {
    display: block;
    margin-top: 0.15em;
    font-family: var(--font-google-sans-code), ui-monospace, monospace;
    font-size: 0.55em;
    font-style: normal;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--nv-muted);
    opacity: 0.6;
    text-shadow: none;
  }
  /* Desktop: a real wall, words scattered where they were written. */
  @media (min-width: 760px) {
    .wall-surface {
      aspect-ratio: 16 / 9;
      padding: 0;
    }
    .chalk {
      position: absolute;
      left: var(--x);
      top: var(--y);
      margin: 0;
      max-width: 34%;
    }
  }
  figcaption {
    margin-top: 0.6rem;
    font-size: 0.8em;
    font-style: italic;
    text-align: center;
    color: var(--nv-muted);
  }
</style>
